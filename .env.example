# Local development. Never commit this file.
DATABASE_URL="postgresql://kiddocraft:PASSWORD@localhost:5432/kiddocraft?schema=public"
# Public URL used for canonical links, sitemap and structured data.
NEXT_PUBLIC_SITE_URL="http://localhost:3210"
# Signs the admin session cookie. Change it in production.
SESSION_SECRET="generate-a-long-random-string"
# First admin account, created by the seed (npm run db:seed).
ADMIN_EMAIL="admin@kiddocraft.tn"
ADMIN_PASSWORD="choose-a-strong-password"
